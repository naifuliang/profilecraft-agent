# Never commit real values. Keep live credentials in your shell or secret manager.
PROFILECRAFT_LINKEDIN_ACCESS_TOKEN=replace-with-a-short-lived-token
PROFILECRAFT_LINKEDIN_PERSON_ID=replace-with-your-member-id
PROFILECRAFT_LINKEDIN_VERSION=YYYYMM

# Live writes require this explicit process-level opt-in as well as a preview ID.
PROFILECRAFT_ENABLE_WRITES=0
